# TypeSafe (Jev) key for the judge packs. https://typesafe.ai
# Read from a checkout by `pnpm dev`, `pnpm start` and every `st` command; the packaged app keeps its key in Settings.
TYPESAFE_API_KEY=
# Optional: cursor engine without `cursor-agent login`
CURSOR_API_KEY=
# Optional: keys for the assistant ("write with AI"). The packaged app keeps them in Settings;
# the `claude` and `codex` CLIs work with no key at all.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

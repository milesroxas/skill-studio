{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@core/*": ["./core/*"],
      "@server/*": ["./server/*"],
      "@judges/*": ["./judges/*"],
      "@cli/*": ["./cli/*"],
      "@app/*": ["./app/src/*"]
    }
  },
  "include": ["core", "server", "judges", "cli", "app/src", "app/vite.config.ts"]
}

{
  "name": "skill-tester",
  "version": "0.1.0",
  "private": true,
  "description": "Eval harness for agent skills: generate outputs with headless agents, grade them with code checks and Jev judge packs, review blind.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesroxas/skill-tester.git"
  },
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "start": "pnpm build --logLevel warn && tsx cli/st.ts serve --open",
    "st": "tsx cli/st.ts",
    "app": "vite --config app/vite.config.ts",
    "build": "vite build --config app/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@typesafe-ai/sdk": "0.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}

{
  "name": "skill-studio",
  "version": "0.11.0",
  "private": true,
  "description": "Desktop studio for agent skills: write a skill, run headless agents on its cases, and compare each version's outputs side by side, graded by Jev on the skill's own rules and checks.",
  "license": "MIT",
  "author": "Miles Roxas",
  "homepage": "https://github.com/milesroxas/skill-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/milesroxas/skill-studio.git"
  },
  "packageManager": "pnpm@12.6.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24",
      "onFail": "error"
    }
  },
  "type": "module",
  "scripts": {
    "postinstall": "install-electron",
    "bootstrap": "node scripts/bootstrap.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/third-party-licenses.ts",
    "dist": "pnpm build && electron-builder",
    "st": "tsx src/interfaces/cli/st.ts",
    "guide:shots": "pnpm build && tsx scripts/guide-shots/index.ts",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "fallow": "fallow dead-code --quiet",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "health": "pnpm test:coverage && fallow health",
    "check": "pnpm typecheck && pnpm lint && pnpm fallow && pnpm test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@typesafe-ai/sdk": "0.7.0",
    "electron-updater": "^6.8.11",
    "openai": "^7.50.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fallow": "^3.39.0",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "productName": "Skill Studio",
  "main": "./out/main/index.js"
}
